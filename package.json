{
  "name": "torrent-parser",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:eslint": "eslint . --fix --cache",
    "lint:oxlint": "oxlint . --fix",
    "format": "oxfmt src/ scripts/"
  },
  "dependencies": {
    "bencode": "4.0.1",
    "pinia": "4.1.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/bencode": "^4.0.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.90.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "9.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=26.10"
  },
  "packageManager": "pnpm@12.16.1"
}
